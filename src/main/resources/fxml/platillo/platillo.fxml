<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utj.evnd.poo.restaurante.controller.PlatilloController"
      spacing="10">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15" />
    </padding>

    <Label text="Platillo - CRUD" style="-fx-font-size: 20; -fx-font-weight: bold;" />

    <HBox spacing="15">
        <GridPane hgap="10" vgap="8">
            <TextField fx:id="txtId" promptText="ID" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" promptText="Nombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <ComboBox fx:id="cmbCategoria" promptText="Categoría" prefWidth="170" GridPane.columnIndex="2" GridPane.rowIndex="0" />

            <TextField fx:id="txtDescripcion" promptText="Descripción" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtPrecio" promptText="Precio" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="txtExistencia" promptText="Existencia" GridPane.columnIndex="2" GridPane.rowIndex="1" />

            <TextField fx:id="txtDescuento" promptText="Descuento (%)" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbEstado" promptText="Estado" prefWidth="170" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtUrlImagen" promptText="URL Imagen" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        </GridPane>
        <VBox spacing="8" alignment="TOP_CENTER">
            <ImageView fx:id="imgPlatillo" fitWidth="120" fitHeight="120" style="-fx-background-color: black;" />
            <Button text="Cargar Imagen" onAction="#cargarImagen" />
        </VBox>
    </HBox>

    <HBox spacing="8">
        <Button text="Agregar" onAction="#agregar" />
        <Button text="Limpiar" onAction="#limpiar" />
        <Button text="Buscar" onAction="#buscar" />
        <Button text="Actualizar" onAction="#actualizar" />
        <Button text="Borrar" onAction="#borrar" />
        <Button text="Cancelar" onAction="#cancelar" />
    </HBox>

    <TableView fx:id="tablaPlatillos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" />
            <TableColumn fx:id="colNombre" text="Nombre" />
            <TableColumn fx:id="colDescripcion" text="Descripción" />
            <TableColumn fx:id="colCategoria" text="Categoría" />
            <TableColumn fx:id="colPrecio" text="Precio" />
            <TableColumn fx:id="colExistencia" text="Existencia" />
            <TableColumn fx:id="colDescuento" text="Descuento (%)" />
            <TableColumn fx:id="colEstado" text="Estado" />
            <TableColumn fx:id="colUrlImagen" text="Imagen" />
        </columns>
    </TableView>
</VBox>
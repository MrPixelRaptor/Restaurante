<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="14"
      fx:controller="edu.utj.evnd.poo.restaurante.controller.ReservaController">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24" />
    </padding>

    <Label text="Reservas" style="-fx-font-size: 26; -fx-font-weight: bold;" />

    <GridPane hgap="14" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="90" />
            <ColumnConstraints hgrow="ALWAYS" />
            <ColumnConstraints minWidth="90" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="ID reserva" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtId" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Cliente" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <ComboBox fx:id="cmbCliente" maxWidth="Infinity" promptText="Selecciona un cliente"
                  GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Mesa" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtMesa" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Fecha" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <DatePicker fx:id="dpFecha" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label text="Hora" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="cmbHora" maxWidth="Infinity" promptText="Selecciona la hora"
                  GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="Personas" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <TextField fx:id="txtPersonas" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <Label text="Estado" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="cmbEstado" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>

    <HBox spacing="10">
        <Button text="Agregar" onAction="#agregar" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button text="Actualizar" onAction="#actualizar" style="-fx-background-color: #F57C00; -fx-text-fill: white;" />
        <Button text="Borrar" onAction="#borrar" style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button text="Buscar" onAction="#buscar" style="-fx-background-color: #0288D1; -fx-text-fill: white;" />
        <Button text="Limpiar" onAction="#limpiar" style="-fx-background-color: #757575; -fx-text-fill: white;" />
        <Button text="Cancelar" onAction="#cancelar" style="-fx-background-color: #78909C; -fx-text-fill: white;" />
    </HBox>

    <TableView fx:id="tablaReservas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" />
            <TableColumn fx:id="colCliente" text="Cliente" />
            <TableColumn fx:id="colMesa" text="Mesa" />
            <TableColumn fx:id="colFecha" text="Fecha" />
            <TableColumn fx:id="colHora" text="Hora" />
            <TableColumn fx:id="colPersonas" text="Personas" />
            <TableColumn fx:id="colEstado" text="Estado" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utj.evnd.poo.restaurante.controller.LoginController"
      spacing="12" prefWidth="340">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25" />
    </padding>

    <Label text="Restaurante" style="-fx-font-size: 24; -fx-font-weight: bold;" />
    <Label text="Inicia sesión para continuar" />
    <TextField fx:id="txtIdentificador" promptText="ID o correo electrónico" />
    <PasswordField fx:id="txtContrasena" promptText="Contraseña" />
    <Label fx:id="lblError" wrapText="true" minHeight="30" style="-fx-text-fill: #C62828;" />
    <Button text="Iniciar sesión" onAction="#iniciarSesion" defaultButton="true" maxWidth="Infinity" />
</VBox>